{
  "name": "iphone-duo-expo-rn",
  "version": "0.1.0",
  "description": "The iPhone \"Duo\" frosted-glass fold effect for any Expo app - TypeScript only, no native code.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-router",
    "iphone-duo-expo-rn",
    "IphoneDuoExpoRn",
    "duo",
    "fold",
    "frosted-glass",
    "parallax",
    "tilt",
    "device-motion",
    "animation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binnicordova/iphone-duo-expo-rn.git"
  },
  "bugs": {
    "url": "https://github.com/binnicordova/iphone-duo-expo-rn/issues"
  },
  "author": "Binni Cordova <binni.2000.cordova@gmail.com> (https://binnicordova.com)",
  "license": "MIT",
  "homepage": "https://github.com/binnicordova/iphone-duo-expo-rn#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~55.0.8",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.21",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.0.0",
    "react-native": "0.82.1",
    "typescript": "^5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": "*",
    "react-native": "*",
    "expo-blur": "*",
    "expo-linear-gradient": "*",
    "expo-sensors": "*"
  },
  "sideEffects": false,
  "peerDependenciesMeta": {
    "expo-blur": {
      "optional": true
    },
    "expo-linear-gradient": {
      "optional": true
    },
    "expo-sensors": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
