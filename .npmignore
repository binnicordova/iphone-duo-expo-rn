# Exclude all top-level hidden directories by convention
/.*/

# Exclude tarballs generated by `npm pack`
/*.tgz

# The lockfile is for this repository's own CI, not for consumers — and at
# ~270kB it would be the largest thing in the package by far.
/bun.lock
/package-lock.json
/yarn.lock

__mocks__
__tests__

/babel.config.js
/internal/module_scripts/
/android/src/androidTest/
/android/src/test/
/android/build/
/example/

# The Kotlin reference project is gitignored, but .npmignore replaces
# .gitignore for packaging, so it has to be named again here or the whole
# Android project (gradle wrapper jar included) ships to every installer.
/references/

# Screenshots are for the README on GitHub; shipping them to every installer
# would only add weight, and npm resolves the relative links against the repo.
/docs/
